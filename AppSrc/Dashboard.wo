Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebGroup.pkg
Use cWebSpacer.pkg
Use cWebHtmlBox.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebLabel.pkg
Use cWebList.pkg
Use cWebColumn.pkg

Object oDashboard is a cWebView

    Set piMaxWidth to 1024
    
    Set psCaption to "Dashboard"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"
    
    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 24
        
        WebSetResponsive piColumnCount rmMobile to 1
        WebSetResponsive piColumnCount rmTabletPortrait to 16
    
        Object oTiles_grp is a cWebGroup
            Set piColumnSpan to 24
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 12
            WebSetResponsive piColumnCount rmMobile to 1
            
            Set psCSSClass to "TilesGroup"
    
            Object oWelcomeTile is a cWebHtmlBox
                Set piColumnSpan to 4
                Set psCSSClass to "Tile Light"
                Set psHtml to '<div class="WebCon_Sizer"><div class="Tile_Title">Welcome</div><div class="Tile_Subtitle">--</div></div>'
    
                Procedure OnLoad
                    Send UpdateHTML ('<div class="WebCon_Sizer">' + ;
                                     '<div class="Tile_Title">Welcome</div>' + ;
                                     '<div class="Tile_Subtitle">' - htmlEncode(psUserName(ghoWebSessionManager)) - '</div>' + ;
                                     '</div>')
                End_Procedure
            End_Object
    
            Object oTileEntrenador is a cWebHtmlBox
                Set piColumnSpan to 4
                Set psCSSClass to "Tile LightAlternate"
                Set pbServerOnClick to True
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="click"><div class="Tile_Title">Entrenadores</div><div class="Tile_Subtitle">Gestionar entrenadores</div></div>'

                Procedure OnClick String sId String sParam
                  Send Show of oSelectEntrenador
                End_Procedure
            End_Object

            Object oTileJugador is a cWebHtmlBox
                Set piColumnSpan to 4
                Set psCSSClass to "Tile Dark"
                Set pbServerOnClick to True
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="click"><div class="Tile_Title">Jugadores</div><div class="Tile_Subtitle">Gestionar jugadores</div></div>'

                Procedure OnClick String sId String sParam
                    Send Show of oSelectJugador
                End_Procedure
            End_Object

            Object oTilePosicion is a cWebHtmlBox
                Set piColumnSpan to 4
                Set psCSSClass to "Tile DarkAlternate"
                Set pbServerOnClick to True
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="click"><div class="Tile_Title">Posiciones</div><div class="Tile_Subtitle">Gestionar posiciones</div></div>'

                Procedure OnClick String sId String sParam
                    Send Show of oSelectPosicion
                End_Procedure
            End_Object

            Object oTileEquipo is a cWebHtmlBox
                Set piColumnSpan to 4
                Set psCSSClass to "Tile Light"
                Set pbServerOnClick to True
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="click"><div class="Tile_Title">Equipos</div><div class="Tile_Subtitle">Gestionar equipos</div></div>'

                Procedure OnClick String sId String sParam
                    Send Show of oSelectEquipo
                End_Procedure
            End_Object

            Object oTileLiga is a cWebHtmlBox
                Set piColumnSpan to 4
                Set psCSSClass to "Tile LightAlternate"
                Set pbServerOnClick to True
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="click"><div class="Tile_Title">Ligas</div><div class="Tile_Subtitle">Gestionar ligas</div></div>'

                Procedure OnClick String sId String sParam
                    Send Show of oSelectLiga
                End_Procedure
            End_Object

        End_Object
    
    End_Object
    
    Procedure OnBeforeShow
        // Each time this view is shown we will update the appropriate information.
    End_Procedure

End_Object